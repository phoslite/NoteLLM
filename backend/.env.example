# 运行配置
# APP_NAME=读书阅读助手                 # 应用显示名（config.app_name，默认即可）
APP_HOST=127.0.0.1
APP_PORT=8321
DATA_DIR=data
DB_URL=sqlite:///./data/llmnotebook.db
# MAX_UPLOAD_BYTES=209715200             # 单文件上传体积上限（默认 200MB，改大需注意磁盘与解析耗时）

# AI 接口（OpenAI 兼容，DeepSeek/通义/Ollama 等）
AI_BASE_URL=https://api.deepseek.com # 两种写法：① 基础地址（如 https://api.deepseek.com 或 https://host/v1），按接口模式自动补全（chat→/v1/chat/completions、responses→/v1/responses、anthropic→/v1/messages）；② 完整接口 URL（如 https://host/v1/chat/completions），直接使用不再补全
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_MODE=responses        # 接口格式：responses（DeepSeek 官方）| chat（OpenAI 兼容）| anthropic（Messages API）
AI_TIMEOUT=120
# AI_TEMPERATURE=0.7                     # 文本模型采样温度（留空用模型默认）
AI_VERIFY_SSL=true
# 隐私开关：false 时不向模型发送书籍正文
AI_ENABLE_BODY_SEND=true
# 扫描版 PDF：提问时是否附带当前页图片（需模型支持视觉输入，chat 模式）
AI_SEND_PAGE_IMAGE=false
# 文本 AI 精细参数（DeepSeek 思考模式参考 https://api-docs.deepseek.com/zh-cn/guides/thinking_mode）
# 注意：thinking/推理强度等仅 chat 模式生效；responses 模式仅 max_tokens 生效（映射为 max_output_tokens，待定稿）
# AI_MAX_TOKENS=32768                    # 输出上限（DeepSeek 默认 32K，最大 64K，含思考 token）
# AI_THINKING_TYPE=enabled               # enabled / disabled（思考模式开关；留空不传）
# AI_REASONING_EFFORT=high               # low / medium / high / max（推理强度；thinking=disabled 时不生效）
# AI_TOP_P=1
# AI_FREQUENCY_PENALTY=0
# AI_PRESENCE_PENALTY=0
# AI_STOP=                               # 停止词，多个用英文逗号分隔
# --- Anthropic 模式（AI_MODE=anthropic）---
# base_url 填 https://api.anthropic.com（自动请求 POST /v1/messages，x-api-key + anthropic-version 鉴权）
# AI_ANTHROPIC_VERSION=2023-06-01      # Messages API 版本头（默认即可）
# 注意：anthropic 模式仅支持 max_tokens（必填，默认 4096）/temperature/top_p/stop；
#       thinking/reasoning_effort 等参数为 OpenAI/DeepSeek 专用，anthropic 模式自动忽略

# 多模态视觉 API（M7）：PDF 页面信息提取用，独立于文本 AI，无需额度管理
# SiliconFlow 多模态（OpenAI 兼容 /chat/completions，强制 chat 模式）
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
VISION_TIMEOUT=120
VISION_VERIFY_SSL=true
# SiliconFlow 建议设置生成 token 上限（输入+输出需小于模型上下文窗口）
VISION_MAX_TOKENS=4096
# 多模态视觉精细参数（SiliconFlow OpenAI 兼容；Qwen 等非推理模型不要开启思考相关项）
# VISION_TEMPERATURE=0.7
# VISION_TOP_P=0.9
# VISION_FREQUENCY_PENALTY=0
# VISION_PRESENCE_PENALTY=0
# VISION_ENABLE_THINKING=0              # SiliconFlow enable_thinking（DeepSeek/Zhipu 系推理模型才可开启）
# VISION_THINKING_BUDGET=4096           # SiliconFlow thinking_budget 思维链 token 上限（仅推理模型）
# ===== 视觉提取压缩页图（v1.86）与 OCR 预留扩展 =====
# pages_vlm/ 压缩页图：裁边 + 缩放后作为多模态输入（降 token/请求体/超时率），阅读原图不动
VISION_IMAGE_MAX_WIDTH=1400        # 压缩页图目标宽度（原图宽<=阈值且无裁边收益时复用原图）
VISION_IMAGE_QUALITY=82            # 压缩页图 JPEG 质量（80~90 体积/清晰度平衡）
VISION_IMAGE_TRIM=conservative     # 裁边模式：conservative（只裁>=20px完全空白边带，默认）| aggressive（内容边界+保护带+padding）| none（不裁）
# OCR 预留扩展：本地 OCR 引擎接入点（压缩图生成后同步产出 pages_vlm/page_XXX.txt，视觉提取优先使用，省多模态调用）
# VISION_OCR_ENGINE=tesseract       # 空=关闭（默认走多模态视觉模型）；tesseract=已实现；paddle/rapidocr=预留占位
# VISION_OCR_LANG=chi_sim+eng       # OCR 语言（tesseract 语言包）
# VISION_OCR_BIN=                   # OCR 可执行文件路径；空=走 PATH（如 tesseract）

# 专业术语词库文件路径（与 .env 同级，用户可编辑；默认 domain_terms.txt）
DOMAIN_TERMS_FILE=domain_terms.txt

# ===== 决策 34：LLM 自主挑选 RAG/Skill（挑选器独立模型配置） =====
# 挑选器用于跨书知识路由（阅读页提问时从全库挑选相关书与 Skill 注入）。
# 未填项自动回退主文本模型（AI_*）；填了 RAG_SELECT_BASE_URL/API_KEY/MODEL 则独立使用。
AI_RAG_SELECT_ENABLED=true         # 总开关；false=跳过 LLM 挑选，直接使用规则回退（暖画像 top3 + 谱系 top2 + 关键词）
RAG_SELECT_BASE_URL=
RAG_SELECT_API_KEY=
RAG_SELECT_MODEL=
RAG_SELECT_MODE=
# 空=复用主模型接口格式（responses/chat/anthropic）
RAG_SELECT_TIMEOUT=60
RAG_SELECT_VERIFY_SSL=true
RAG_SELECT_MAX_TOKENS=512          # 挑选输出上限（轻量调用，无需大输出）
RAG_SELECT_TEMPERATURE=0.0         # 挑选要确定性，默认低温
RAG_SELECT_THINKING_TYPE=disabled  # 挑选禁思考（enabled/disabled）
RAG_SELECT_REASONING_EFFORT=       # 挑选推理强度（DeepSeek reasoning_effort：low/medium/high/max，chat 模式；空=回退主模型）
RAG_SELECT_MAX_BOOKS=3             # 预算：最多注入书数（含当前书）
RAG_SELECT_MAX_SKILLS=2            # 预算：最多注入 Skill 数
RAG_SELECT_CACHE_TTL_MINUTES=60    # session_id 会话挑选缓存 TTL（0=不缓存）

# ===== 性能优化（docs/性能优化路径.md §7 决策 1~3） =====
CHAT_HISTORY_LIMIT=200        # 每会话保留最近 N 条消息（0=不限制）
LLM_CACHE_MAX_ENTRIES=300     # LLM 结果缓存容量上限（脑图/预设模式解读；0=关闭缓存）
LLM_CACHE_TTL_DAYS=30         # LLM 结果缓存 TTL（天）
FTS_SEARCH_ENABLED=true       # FTS5 全书搜索开关（false=不建索引，搜索接口返回空）

# ===== 归档总结分块（方案 B map-reduce） =====
# 书籍正文超过 RAG_SUMMARY_CHUNK_CHARS 字符数时，按块分多次提炼（map）再合并（reduce），
# 避免旧 8K 截断只覆盖前几章（主流模型已支持 200K 上下文，块大小定 64K 字符）
RAG_SUMMARY_CHUNK_CHARS=64000    # 单块字符上限（0=不限制，单次发送全文）

# ===== 任务系统与并发（决策 35；任一 =0 表示不限制） =====
TASK_WORKERS=8                # 任务系统全局线程池大小（0=每任务独立线程）
AI_CONCURRENCY=4              # 文本 LLM 并发数（信号量；demo 实测 4 为甜点）
# 联动沉淀 LLM 并发（默认 1=串行；0=不限制；N=上限，cap 8）
GRAPH_SYNC_CONCURRENCY=1
VISION_CONCURRENCY=4          # 视觉 LLM 并发数（信号量；demo 实测 4~8）
PAGE_RENDER_CONCURRENCY=4     # PDF 页图渲染并发（线程池）
TASK_QUOTA_TEXT=4             # 文本类任务全局配额（信号量分池，多任务可同时、总量受限）
TASK_QUOTA_VISION=4           # 视觉类任务全局配额

# 聚类成簇引擎（A3）：LPA 加权标签传播开关，默认关（连通分量基线）；30 本评估后终评
CLUSTER_USE_LPA=false
